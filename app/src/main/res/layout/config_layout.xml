<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration activity layout — email + password login instead of API Key -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DeepSeek Dashboard"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/balance_text"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to your DeepSeek account"
            android:textSize="14sp"
            android:textColor="@color/sub_text"
            android:layout_marginTop="8dp" />

        <!-- Email Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DeepSeek email"
            android:textSize="13sp"
            android:textColor="@color/label_text"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="your@email.com"
            android:inputType="textEmailAddress"
            android:textSize="14sp"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="12dp"
            android:autofillHints="emailAddress" />

        <!-- Password Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="13sp"
            android:textColor="@color/label_text"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="12dp"
            android:autofillHints="password" />

        <!-- 用量统计时区（开放平台 2026-08 起支持自定义时区） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usage timezone"
            android:textSize="13sp"
            android:textColor="@color/label_text"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/sp_tz"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/tz_options"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="12dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tv_config_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/label_text"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                style="?android:attr/buttonStyle" />

            <Button
                android:id="@+id/btn_login"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Sign in"
                android:textSize="14sp"
                android:layout_marginStart="8dp"
                style="?android:attr/buttonStyle" />

        </LinearLayout>

        <!-- 诊断（问题反馈用） -->
        <Button
            android:id="@+id/btn_diag"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Copy diagnostics"
            android:textSize="12sp"
            android:layout_marginTop="12dp"
            style="?android:attr/buttonStyle" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\n💡 Notes:\n• Sign in with your DeepSeek platform account\n• Password is encrypted and stored only on this phone\n• An access token is fetched automatically after sign-in\n• An expired token triggers an automatic re-login\n• Usage data refreshes automatically every 30 minutes\n• Timezone sets the “Today” / “Month” boundaries\n• Tap the widget to refresh on demand"
            android:textSize="12sp"
            android:textColor="@color/sub_text"
            android:layout_marginTop="32dp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</ScrollView>
